{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tabnas.github.io/measure/schemas/deterministic-result.schema.json",
  "title": "Callgrind counts for one Tabnas runtime port",
  "description": "Written by the harness, not by the port: the port's deterministic mode parses one case a fixed number of times, and valgrind counts the process. Every case is counted twice, at the configured iteration count and at zero, and the difference is what the parses cost.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "run",
    "port",
    "tool",
    "runner",
    "iterations",
    "cases"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "run": {
      "$ref": "#/$defs/run"
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "arguments"
      ],
      "properties": {
        "name": {
          "const": "valgrind"
        },
        "version": {
          "type": "string",
          "pattern": "^valgrind-[0-9]"
        },
        "arguments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "arguments",
        "given",
        "environment"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "given": {
          "description": "What the counted process was handed: the host variables passed through by name, from the harness's fixed allowlist, and the configured settings by value. Nothing else from the recording shell reached the process.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inherited",
            "settings"
          ],
          "properties": {
            "inherited": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "settings": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "environment": {
          "description": "The settings the runner reported reading back from its runtime, not the ones it was given. The harness refuses a count whose report differs from the configured settings.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "iterations": {
      "$ref": "#/$defs/positiveInteger"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "generatedAt",
        "profile",
        "suiteVersion",
        "repositoryCommit",
        "repositoryDirty"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "profile": {
          "$ref": "#/$defs/id"
        },
        "suiteVersion": {
          "type": "string"
        },
        "repositoryCommit": {
          "type": "string",
          "minLength": 1
        },
        "repositoryDirty": {
          "type": "boolean"
        }
      }
    },
    "totals": {
      "description": "The profile's totals line, keyed by event name in the profile's event order.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/nonNegativeInteger"
      }
    },
    "count": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iterations",
        "checksum",
        "totals",
        "profile"
      ],
      "properties": {
        "iterations": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "checksum": {
          "description": "What the counted loop checksummed to: iterations times parseChecksum, reduced by the runners' modulus. Zero for the baseline.",
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "totals": {
          "$ref": "#/$defs/totals"
        },
        "profile": {
          "description": "Run-relative path of the callgrind profile this was read from.",
          "type": "string",
          "pattern": "^raw/deterministic/.+\\.out$"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmarkId",
        "caseId",
        "input",
        "parseChecksum",
        "events",
        "caches",
        "measured",
        "baseline"
      ],
      "properties": {
        "benchmarkId": {
          "$ref": "#/$defs/id"
        },
        "caseId": {
          "$ref": "#/$defs/id"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bytes",
            "codeUnits",
            "sha256"
          ],
          "properties": {
            "bytes": {
              "$ref": "#/$defs/positiveInteger"
            },
            "codeUnits": {
              "$ref": "#/$defs/positiveInteger"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "parseChecksum": {
          "description": "What one parse checksums to, from the parse the runner takes before the counted loop in both runs. Never zero: the loop's checksum is checked against it.",
          "$ref": "#/$defs/positiveInteger"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "caches": {
          "description": "The cache geometry callgrind simulated, from the profile's desc: lines.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "measured": {
          "$ref": "#/$defs/count"
        },
        "baseline": {
          "$ref": "#/$defs/count"
        }
      }
    }
  }
}
