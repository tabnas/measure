{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tabnas.github.io/measure/schemas/config.schema.json",
  "title": "Tabnas measurement configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "suiteVersion",
    "profiles",
    "ports"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "suiteVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    },
    "ports": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/port"
      }
    },
    "deterministic": {
      "$ref": "#/$defs/deterministic"
    }
  },
  "$defs": {
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warmupMs",
        "sampleTargetMs",
        "samples",
        "maxIterations"
      ],
      "properties": {
        "warmupMs": {
          "$ref": "#/$defs/positiveInteger"
        },
        "sampleTargetMs": {
          "$ref": "#/$defs/positiveInteger"
        },
        "samples": {
          "type": "integer",
          "minimum": 3
        },
        "maxIterations": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "parser",
        "manifests",
        "command",
        "arguments"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "parser": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "module",
            "version"
          ],
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          }
        },
        "manifests": {
          "description": "Repository-relative files that pin this port's parser exactly. Snapshotted into every run so the revision it measured stays recoverable from the run alone.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deterministic": {
          "description": "Present on a port the deterministic mode counts. The environment is applied to the runner for those runs only (the Go port needs GOMAXPROCS=1 under valgrind).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "environment": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "deterministic": {
      "description": "The deterministic section: a fixed, small case set counted under callgrind rather than timed. Optional, because the mode needs valgrind and a normal run does not.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iterations",
        "cases"
      ],
      "properties": {
        "iterations": {
          "$ref": "#/$defs/positiveInteger"
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$"
          }
        }
      }
    }
  }
}
