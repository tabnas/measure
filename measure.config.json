{
  "$schema": "./schemas/config.schema.json",
  "schemaVersion": 1,
  "suiteVersion": "0.2.0",
  "profiles": {
    "smoke": {
      "warmupMs": 20,
      "sampleTargetMs": 10,
      "samples": 3,
      "maxIterations": 4096
    },
    "full": {
      "warmupMs": 250,
      "sampleTargetMs": 100,
      "samples": 11,
      "maxIterations": 1048576
    }
  },
  "deterministic": {
    "iterations": 20,
    "cases": [
      "adder/terms-512",
      "palindrome/chars-1024"
    ]
  },
  "ports": [
    {
      "id": "typescript",
      "label": "TypeScript / Node.js",
      "parser": {
        "module": "@tabnas/parser",
        "version": "0.12.2"
      },
      "manifests": [
        "package.json",
        "package-lock.json"
      ],
      "command": "node",
      "arguments": [
        "--expose-gc",
        ".build/typescript/main.js"
      ]
    },
    {
      "id": "go",
      "label": "Go",
      "parser": {
        "module": "github.com/tabnas/parser/go",
        "version": "0.12.2"
      },
      "manifests": [
        "go.mod",
        "go.sum"
      ],
      "command": ".build/measure-go",
      "arguments": [],
      "deterministic": {
        "environment": {
          "GOMAXPROCS": "1",
          "GOGC": "off"
        }
      }
    },
    {
      "id": "rust",
      "label": "Rust",
      "parser": {
        "module": "tabnas",
        "version": "0.12.2"
      },
      "manifests": [
        "ports/rust/Cargo.toml",
        "ports/rust/Cargo.lock"
      ],
      "command": ".build/measure-rust",
      "arguments": [],
      "deterministic": {}
    }
  ]
}
