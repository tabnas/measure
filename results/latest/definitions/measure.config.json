{
  "$schema": "./schemas/config.schema.json",
  "schemaVersion": 1,
  "suiteVersion": "0.1.0",
  "profiles": {
    "smoke": {
      "warmupMs": 20,
      "sampleTargetMs": 10,
      "samples": 3,
      "maxIterations": 4096
    },
    "full": {
      "warmupMs": 250,
      "sampleTargetMs": 100,
      "samples": 11,
      "maxIterations": 1048576
    }
  },
  "ports": [
    {
      "id": "typescript",
      "label": "TypeScript / Node.js",
      "parser": {
        "module": "@tabnas/parser",
        "version": "0.9.0"
      },
      "command": "node",
      "arguments": [
        "--expose-gc",
        ".build/typescript/main.js"
      ]
    },
    {
      "id": "go",
      "label": "Go",
      "parser": {
        "module": "github.com/tabnas/parser/go",
        "version": "0.9.0"
      },
      "command": ".build/measure-go",
      "arguments": []
    }
  ]
}
