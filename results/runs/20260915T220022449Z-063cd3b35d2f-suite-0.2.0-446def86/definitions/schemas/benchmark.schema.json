{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tabnas.github.io/measure/schemas/benchmark.schema.json",
  "title": "Tabnas benchmark manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "summary",
    "classification",
    "capabilityCases",
    "performanceCases"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "classification": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "capabilityCases": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/capabilityCase" }
    },
    "performanceCases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/performanceCase" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "capabilityCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "input", "accept"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "minLength": 1 },
        "input": { "type": "string" },
        "accept": { "type": "boolean" },
        "expected": true
      },
      "allOf": [
        {
          "if": { "properties": { "accept": { "const": true } } },
          "then": { "properties": { "expected": true }, "required": ["expected"] }
        }
      ]
    },
    "performanceCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "generator"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "minLength": 1 },
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "size"],
          "properties": {
            "kind": { "$ref": "#/$defs/id" },
            "size": { "type": "integer", "minimum": 1 },
            "pattern": { "type": "string", "minLength": 1 },
            "value": { "type": "integer" }
          }
        }
      }
    }
  }
}
