{
  "$schema": "../../schemas/benchmark.schema.json",
  "schemaVersion": 1,
  "id": "adder",
  "title": "Adder grammar",
  "summary": "Canonical Tabnas integer-addition grammar with semantic accumulation.",
  "classification": [
    "deterministic",
    "semantic-action",
    "repetition"
  ],
  "reference": {
    "label": "Tabnas quickstart",
    "url": "https://tabnas.dev/docs/quickstart"
  },
  "capabilityCases": [
    {
      "id": "single",
      "description": "One number is a complete expression.",
      "input": "1",
      "accept": true,
      "expected": 1
    },
    {
      "id": "chain",
      "description": "Three terms accumulate on the parent node.",
      "input": "1+2+3",
      "accept": true,
      "expected": 6
    },
    {
      "id": "multi-digit",
      "description": "Multi-digit number tokens retain their numeric values.",
      "input": "12+3+45",
      "accept": true,
      "expected": 60
    },
    {
      "id": "trailing-plus",
      "description": "A plus sign must be followed by another number.",
      "input": "1+",
      "accept": false
    },
    {
      "id": "leading-plus",
      "description": "An expression cannot begin with plus.",
      "input": "+1",
      "accept": false
    },
    {
      "id": "double-plus",
      "description": "An empty term between plus signs is rejected.",
      "input": "1++2",
      "accept": false
    },
    {
      "id": "unknown-token",
      "description": "Unrecognized arithmetic syntax is rejected.",
      "input": "1+*2",
      "accept": false
    }
  ],
  "performanceCases": [
    {
      "id": "terms-8",
      "description": "Eight one-digit terms.",
      "generator": {
        "kind": "adder-chain",
        "size": 8,
        "value": 1
      }
    },
    {
      "id": "terms-64",
      "description": "Sixty-four one-digit terms.",
      "generator": {
        "kind": "adder-chain",
        "size": 64,
        "value": 1
      }
    },
    {
      "id": "terms-512",
      "description": "Five hundred twelve one-digit terms.",
      "generator": {
        "kind": "adder-chain",
        "size": 512,
        "value": 1
      }
    },
    {
      "id": "terms-4096",
      "description": "Four thousand ninety-six one-digit terms.",
      "generator": {
        "kind": "adder-chain",
        "size": 4096,
        "value": 1
      }
    }
  ]
}
