{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tabnas.github.io/measure/schemas/history.schema.json",
  "title": "Tabnas comparable historical performance series",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "series"],
  "properties": {
    "$schema": { "const": "https://tabnas.github.io/measure/schemas/history.schema.json" },
    "schemaVersion": { "const": 3 },
    "series": { "type": "array", "items": { "$ref": "#/$defs/series" } }
  },
  "$defs": {
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "suiteVersion",
        "benchmarkId",
        "caseId",
        "description",
        "input",
        "portId",
        "portLabel",
        "runtime",
        "runtimeVersion",
        "host",
        "environmentFingerprint",
        "environment",
        "points"
      ],
      "properties": {
        "id": { "type": "string" },
        "suiteVersion": { "type": "string" },
        "benchmarkId": { "type": "string" },
        "caseId": { "type": "string" },
        "description": { "type": "string" },
        "input": { "type": "object" },
        "portId": { "type": "string" },
        "portLabel": { "type": "string" },
        "runtime": { "type": "string" },
        "runtimeVersion": { "type": "string" },
        "host": { "$ref": "#/$defs/host" },
        "environmentFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "environment": { "$ref": "#/$defs/environment" },
        "points": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/point" } }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "environmentFingerprint",
        "os",
        "osName",
        "kernelVersion",
        "arch",
        "cpu",
        "logicalCpus",
        "memoryBytes"
      ],
      "properties": {
        "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{12}$" },
        "environmentFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "os": { "type": "string" },
        "osName": { "type": "string" },
        "kernelVersion": { "type": "string" },
        "arch": { "type": "string" },
        "cpu": { "type": "string" },
        "logicalCpus": { "type": "integer", "minimum": 1 },
        "memoryBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "hostFingerprint",
        "os",
        "osName",
        "kernelVersion",
        "arch",
        "cpu",
        "logicalCpus",
        "memoryBytes"
      ],
      "properties": {
        "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "hostFingerprint": { "type": "string", "pattern": "^[a-f0-9]{12}$" },
        "os": { "type": "string" },
        "osName": { "type": "string", "minLength": 1 },
        "kernelVersion": { "type": "string", "minLength": 1 },
        "arch": { "type": "string" },
        "cpu": { "type": "string" },
        "logicalCpus": { "type": "integer", "minimum": 1 },
        "memoryBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "generatedAt",
        "repositoryCommit",
        "parserVersion",
        "hostFingerprint",
        "medianNs",
        "p95Ns",
        "operationsPerSecond",
        "coefficientOfVariationPercent"
      ],
      "properties": {
        "runId": { "type": "string" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "repositoryCommit": { "type": "string" },
        "parserVersion": { "type": "string" },
        "hostFingerprint": { "type": "string", "pattern": "^[a-f0-9]{12}$" },
        "medianNs": { "type": "number", "exclusiveMinimum": 0 },
        "p95Ns": { "type": "number", "exclusiveMinimum": 0 },
        "operationsPerSecond": { "type": "number", "exclusiveMinimum": 0 },
        "coefficientOfVariationPercent": { "type": "number", "minimum": 0 }
      }
    }
  }
}
