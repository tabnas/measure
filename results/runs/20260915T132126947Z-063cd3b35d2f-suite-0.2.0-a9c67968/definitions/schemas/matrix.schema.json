{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tabnas.github.io/measure/schemas/matrix.schema.json",
  "title": "Validated cross-port Tabnas measurement matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "run", "ports", "benchmarks", "capabilityMatrix", "performanceMatrix"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 3 },
    "run": { "type": "object" },
    "ports": { "type": "array", "minItems": 2, "items": { "type": "object" } },
    "benchmarks": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "capabilityMatrix": { "type": "array", "items": { "$ref": "#/$defs/capabilityRow" } },
    "performanceMatrix": { "type": "array", "items": { "$ref": "#/$defs/performanceRow" } }
  },
  "$defs": {
    "capabilityRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benchmarkId", "caseId", "description", "acceptExpected", "ports"],
      "properties": {
        "benchmarkId": { "type": "string" },
        "caseId": { "type": "string" },
        "description": { "type": "string" },
        "acceptExpected": { "type": "boolean" },
        "expected": true,
        "ports": { "type": "object", "minProperties": 2 }
      }
    },
    "performanceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benchmarkId", "caseId", "description", "input", "ports", "relativeThroughput"],
      "properties": {
        "benchmarkId": { "type": "string" },
        "caseId": { "type": "string" },
        "description": { "type": "string" },
        "input": { "type": "object" },
        "ports": { "type": "object", "minProperties": 2 },
        "relativeThroughput": { "type": "object", "minProperties": 2 }
      }
    }
  }
}
